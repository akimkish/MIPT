# .env.example (корень репозитория)
# Переменные, общие для docker-compose.yml целиком. Переменные конкретного
# сервиса (DATABASE_URL, JWT-ключи и т.д.) — в <service>/.env.example,
# сюда не дублируются.

# Имя проекта — используется в имени сети и как префикс имён контейнеров/volume.
COMPOSE_PROJECT_NAME=lamp-store

# Тег образа Postgres, общий для всех трёх контейнеров БД.
POSTGRES_IMAGE_TAG=16-alpine

# Учётные данные Postgres, общие для всех трёх контейнеров БД.
# ВАЖНО: должны буквально совпадать с user:password в DATABASE_URL каждого
# сервиса (<service>/.env) — это одна и та же пара логин/пароль к трём
# разным базам. Имя базы (lamp_products/lamp_orders/lamp_admin) задано
# отдельно в docker-compose.yml и здесь не настраивается.
POSTGRES_USER=lamp
POSTGRES_PASSWORD=lamp

# Порты сервисов наружу (слева от ":" в docker-compose ports).
# Порт контейнера (справа) зашит в docker-compose.yml и должен совпадать
# с APP_PORT в .env соответствующего сервиса — при смене APP_PORT
# в <service>/.env поменяйте и правую часть маппинга в docker-compose.yml.
PRODUCTS_SERVICE_HOST_PORT=8001
ORDERS_SERVICE_HOST_PORT=8002
ADMIN_SERVICE_HOST_PORT=8003

# Порты БД наружу — только для локального psql/DBeaver с хоста.
# Внутри docker-сети сервисы обращаются к БД по имени контейнера и 5432,
# этих переменных не касаются.
PRODUCTS_DB_HOST_PORT=5433
ORDERS_DB_HOST_PORT=5434
ADMIN_DB_HOST_PORT=5435

INTERNAL_API_KEY=k7Qx2mR9vT4wLp8NzB3sYd6HjF1aCgE51