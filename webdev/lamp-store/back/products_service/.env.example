# products_service/.env.example

# === ОБЯЗАТЕЛЬНЫЕ (без них сервис не стартует, дефолтов нет) ===

# Строка подключения к своей БД, асинхронный драйвер asyncpg.
# Хост "products_db" — имя сервиса в docker-compose; при локальном запуске вне
# docker поменяйте на localhost и проброшенный порт.
DATABASE_URL=postgresql+asyncpg://lamp:lamp@products_db:5432/lamp_products

# Публичный ключ для проверки подписи JWT (RS256), PEM в base64 (из-за переносов строк).
# Значение ОДИНАКОВОЕ во всех трёх сервисах — это публичная половина ключевой пары,
# приватная лежит только в admin_service и наружу не идёт.
JWT_PUBLIC_KEY_B64=<base64-encoded RSA public key PEM, placeholder>

# Ключ для аутентификации service-to-service запросов от orders_service
# (заголовок X-Internal-Token, сверка secrets.compare_digest).
# Общий с orders_service (там он тоже INTERNAL_API_KEY, тем же значением).
INTERNAL_API_KEY=<shared-secret-placeholder-change-me>

# === НЕОБЯЗАТЕЛЬНЫЕ (есть дефолт в Settings, переопределяйте по необходимости) ===

# Алгоритм подписи JWT. Дефолт RS256 — менять не нужно без миграции всей auth-схемы.
JWT_ALGORITHM=RS256

# Ожидаемые iss/aud в токене — совпадают с тем, что admin_service кладёт при выпуске.
JWT_ISSUER=admin_service
JWT_AUDIENCE=lamp-store

# Порт, на котором uvicorn слушает внутри контейнера.
APP_PORT=8001

# Уровень логирования: DEBUG/INFO/WARNING/ERROR.
LOG_LEVEL=INFO

# Параметры ожидания готовности БД при старте (wait_for_db), см. db/database.py.
DB_CONNECT_ATTEMPTS=10
DB_CONNECT_DELAY=1.0

