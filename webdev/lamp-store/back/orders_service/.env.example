# orders_service/.env.example

# === ОБЯЗАТЕЛЬНЫЕ (без них сервис не стартует, дефолтов нет) ===

# Строка подключения к своей БД, асинхронный драйвер asyncpg.
DATABASE_URL=postgresql+asyncpg://lamp:lamp@orders_db:5432/lamp_orders

# Публичный ключ для проверки подписи JWT (RS256), PEM в base64.
# Значение ОДИНАКОВОЕ во всех трёх сервисах — публичная половина ключевой пары,
# приватная лежит только в admin_service. orders_service использует его только
# для admin-эндпоинта смены статуса заказа (paid/shipped/completed) — публичный
# каталог заказов (создание/отмена/чтение) авторизации не требует вовсе.
JWT_PUBLIC_KEY_B64=<base64-encoded RSA public key PEM, placeholder>

# Ключ для аутентификации service-to-service запросов К products_service
# (заголовок X-Internal-Token на исходящих reserve/release). Общий с
# products_service (там он тоже INTERNAL_API_KEY, тем же значением) —
# orders_service выступает клиентом, а не получателем этого заголовка.
INTERNAL_API_KEY=<shared-secret-placeholder-change-me>

# Базовый URL products_service — единственный сервис, к которому orders_service
# обращается по HTTP (stock/reserve, stock/release).
PRODUCTS_SERVICE_URL=http://products_service:8001

# === НЕОБЯЗАТЕЛЬНЫЕ (есть дефолт в Settings, переопределяйте по необходимости) ===

JWT_ALGORITHM=RS256
JWT_ISSUER=admin_service
JWT_AUDIENCE=lamp-store
JWT_LEEWAY_SECONDS=10

# Порт, на котором uvicorn слушает внутри контейнера.
APP_PORT=8002

# Уровень логирования: DEBUG/INFO/WARNING/ERROR.
LOG_LEVEL=INFO

# Параметры ожидания готовности своей БД при старте (wait_for_db).
DB_CONNECT_ATTEMPTS=10
DB_CONNECT_DELAY=1.0

# Таймауты HTTP-клиента к products_service, секунды. Ретраев нет — одна
# попытка, читаемый тип исключения решает, была ли операция на products
# определённо не выполнена (ConnectError/ConnectTimeout) или неизвестна
# (ReadTimeout/5xx). Read выше Connect: reserve делает реальную работу в БД
# products_service (проверка активности + атомарные UPDATE по позициям).
PRODUCTS_SERVICE_TIMEOUT_CONNECT=3.0
PRODUCTS_SERVICE_TIMEOUT_READ=10.0

TEST_DATABASE_URL=postgresql+asyncpg://lamp:lamp@localhost:5435/lamp_orders_test