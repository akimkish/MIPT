# admin_service/.env.example

# === ОБЯЗАТЕЛЬНЫЕ (без них сервис не стартует, дефолтов нет) ===

# Строка подключения к своей БД, асинхронный драйвер asyncpg.
DATABASE_URL=postgresql+asyncpg://lamp:lamp@admin_db:5432/lamp_admin

# Приватный ключ RS256 для подписи выпускаемых JWT, PEM в base64.
# Единственный сервис, где он есть — в products_service и orders_service
# только публичная половина. За пределы admin_service значение не выходит.
JWT_PRIVATE_KEY_B64=<base64-encoded RSA private key PEM, placeholder>

# Публичный ключ для проверки подписи JWT на собственных защищённых
# эндпоинтах admin_service (например, смена роли админа).
# Значение ОДИНАКОВОЕ во всех трёх сервисах — публичная половина той же пары,
# что и JWT_PRIVATE_KEY_B64 выше.
JWT_PUBLIC_KEY_B64=<base64-encoded RSA public key PEM, placeholder>

# Данные первого суперадмина. Используются один раз при старте, если таблица
# admins пуста (см. domain_decisions). После создания первого админа эти
# переменные можно оставить как есть — повторный запуск ловит IntegrityError
# при гонке и не создаёт дубликат.
FIRST_ADMIN_EMAIL=admin@lampstore.dev
FIRST_ADMIN_PASSWORD=<change-me-strong-password>

# === НЕОБЯЗАТЕЛЬНЫЕ (есть дефолт в Settings, переопределяйте по необходимости) ===

JWT_ALGORITHM=RS256
JWT_ISSUER=admin_service
JWT_AUDIENCE=lamp-store
JWT_LEEWAY_SECONDS=10

# TTL access-токена, минуты. Refresh-токенов и отзыва нет (см.
# rejected_alternatives) — права и активность админа заморожены на этот срок.
ACCESS_TOKEN_TTL_MINUTES=30

# Порог блокировки по неудачным входам и длительность блокировки.
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Порт, на котором uvicorn слушает внутри контейнера.
APP_PORT=8003

# Уровень логирования: DEBUG/INFO/WARNING/ERROR.
LOG_LEVEL=INFO

# Параметры ожидания готовности своей БД при старте (wait_for_db).
DB_CONNECT_ATTEMPTS=10
DB_CONNECT_DELAY=1.0

# У admin_service НЕТ URL других сервисов и INTERNAL_API_KEY: это чистый
# identity-сервис, сам он ни к products_service, ни к orders_service по HTTP
# не обращается (см. project_structure — нет clients/ и internal.py).

TEST_DATABASE_URL=postgresql+asyncpg://lamp:lamp@localhost:5435/lamp_admin_test